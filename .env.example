# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://platform:platform@localhost:5432/platform_dev"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth service ──────────────────────────────────────────────────────────────
AUTH_SERVICE_URL="http://localhost:3001"

# JWT signing keys (generate with: openssl rand -base64 64)
JWT_ACCESS_SECRET="changeme-access-secret"
JWT_REFRESH_SECRET="changeme-refresh-secret"
JWT_PLUGIN_SECRET="changeme-plugin-secret"

# ── OAuth2 providers ──────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3001/auth/github/callback"

GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
GITLAB_CALLBACK_URL="http://localhost:3001/auth/gitlab/callback"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# ── Object storage (MinIO locally, S3 in prod) ────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_PLUGINS="platform-plugins"
S3_BUCKET_SNAPSHOTS="platform-snapshots"
S3_REGION="us-east-1"

# ── Services ──────────────────────────────────────────────────────────────────
GATEWAY_PORT=3000
AUTH_PORT=3001
PLUGIN_REGISTRY_PORT=3002
EXEC_SANDBOX_PORT=3003
COLLAB_PORT=3004
TELEMETRY_PORT=3005

# ── HashiCorp Vault ───────────────────────────────────────────────────────────
VAULT_ADDR="http://localhost:8200"
VAULT_TOKEN="root"

# ── Unleash (feature flags) ───────────────────────────────────────────────────
UNLEASH_URL="http://localhost:4242/api"
UNLEASH_API_TOKEN="default:development.changeme"
UNLEASH_APP_NAME="platform"

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="platform"

# ── Exec sandbox ──────────────────────────────────────────────────────────────
SANDBOX_DOCKER_SOCKET="/var/run/docker.sock"
SANDBOX_SECCOMP_PROFILE="./profiles/sandbox.json"

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:5173"
