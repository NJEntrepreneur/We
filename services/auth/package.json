  },
  "dependencies": {
    "@platform/types": "workspace:*",
    "@platform/utils": "workspace:*",
    "@prisma/client": "^5.0.0",
    "bullmq": "^5.0.0",
    "fastify": "^4.0.0",
    "jose": "^5.0.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-oauth2": "^1.7.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/passport": "^1.0.0",
    "@types/passport-local": "^1.0.0",
    "prisma": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
