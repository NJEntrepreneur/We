    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "jose": "^5.4.0",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/passport": "^1.0.16",
    "prisma": "^5.14.0",
