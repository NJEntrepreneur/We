// §10: snake_case table/column names, uuid PKs at app layer, soft deletes via deleted_at

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Plugin {
  id            String    @id
  pluginId      String    @unique @map("plugin_id")
  name          String
  publisherId   String    @map("publisher_id")
  latestVersion String?   @map("latest_version")
  publishedAt   DateTime  @map("published_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  versions      PluginVersion[]

  @@map("plugins")
}

model PluginVersion {
  id            String   @id
  pluginRowId   String   @map("plugin_row_id")
  version       String
  integrityHash String   @map("integrity_hash")
  manifest      Json
  bundleUrl     String   @map("bundle_url")
  createdAt     DateTime @default(now()) @map("created_at")

  plugin        Plugin   @relation(fields: [pluginRowId], references: [id])

  @@unique([pluginRowId, version])
  @@map("plugin_versions")
}
